NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# サーバー専用。Supabaseダッシュボードの Project Settings > API から取得(絶対に公開しないこと)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push (VAPIDキー)。`npx web-push generate-vapid-keys` で生成できる
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知送信元として名乗る連絡先(mailto:の形式)
VAPID_SUBJECT=mailto:contact@example.com

# Supabaseのnotifications INSERTトリガー(pg_net)から/api/push/sendを呼び出す際の認証シークレット。
# ランダムな文字列を生成し、Supabase側の app_settings.push_webhook_secret にも同じ値を設定すること
PUSH_WEBHOOK_SECRET=
